# Copy to .env. Keep it private. Never use these placeholders in production.
# Use the same URL-safe password in POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_USER=crocode
POSTGRES_PASSWORD=replace-with-url-safe-db-password
POSTGRES_DB=crocode
DATABASE_URL=postgres://crocode:replace-with-url-safe-db-password@postgres:5432/crocode

# Leave the GitHub App values empty to create the app from the dashboard
# setup page. Set all of them to configure an existing app by hand; they then
# take precedence over the stored app.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# Single quotes preserve literal \n. CroCode converts them to PEM line breaks.
GITHUB_PRIVATE_KEY=
# Alternative: mount a PEM file into api and worker, then set its container path.
# GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Dashboard variables (OAuth client, Better Auth secret and URL) go in
# web/.env. Copy web/.env.example. Keep them out of this file.

CROCODE_BIND=0.0.0.0:8080
# All three agents are supported. Codex needs working bubblewrap namespaces.
# This host blocks them, so the example enables the other two agents.
CROCODE_AGENTS=claude,opencode
CROCODE_DEFAULT_AGENT=claude
# Optional fallback on provider usage limits: an enabled agent, or auto for
# Claude <-> Codex. auto requires both agents in CROCODE_AGENTS.
CROCODE_FALLBACK_AGENT=
CROCODE_SANDBOX=docker
CROCODE_SANDBOX_IMAGE=crocode-sandbox:latest
# OSV lookup tools need HTTPS access to api.osv.dev. No OSV API key is needed.
CROCODE_SANDBOX_NETWORK=bridge
# Optional installed Docker runtime, for example runsc.
CROCODE_SANDBOX_RUNTIME=
# Must be the SAME absolute host and worker path. Create it with owner 10000:10000.
CROCODE_WORK_DIR=/var/lib/crocode/work
# Set from: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
CROCODE_WORKER_CONCURRENCY=4
CROCODE_MAX_PER_INSTALLATION=2
CROCODE_AGENT_TIMEOUT_SECS=900
CROCODE_MAX_REPO_SIZE_MB=1024
# Extra agent env NAMES only. Never include GitHub, database, or session secrets.
CROCODE_AGENT_ENV=
CROCODE_LOG_FORMAT=json
RUST_LOG=info

# Fill only the credentials and endpoints for your chosen agent/provider.
# Empty values do not authorize model calls.
ANTHROPIC_API_KEY=
# Claude subscription token from `claude setup-token`. Used only when
# ANTHROPIC_API_KEY is empty.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_BASE_URL=
CLAUDE_CODE_USE_BEDROCK=
CLAUDE_CODE_USE_VERTEX=
# Optional dedicated host directory with Codex ChatGPT credentials.
# Only enable after the sandbox probes pass. Use a dedicated CroCode login.
CROCODE_CODEX_AUTH_DIR=
CODEX_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
