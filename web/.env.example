# Leave the GitHub values, BETTER_AUTH_SECRET, and BETTER_AUTH_URL empty to
# use the app from first-run setup. Set values take precedence.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Generate with `openssl rand -base64 32`. Keep this value private and stable.
BETTER_AUTH_SECRET=
# Public dashboard origin, with no path. The GitHub callback is
# ${BETTER_AUTH_URL}/api/auth/callback/github.
BETTER_AUTH_URL=
CROCODE_API_URL=http://localhost:8080
